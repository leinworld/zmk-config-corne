#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 3 1>; };

&lt { tapping-term-ms = <350>; };

&mt { tapping-term-ms = <350>; };

/ {
    behaviors {
        tlt: tlt {
            compatible = "zmk,behavior-hold-tap";
            label = "TabPreferedLT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <160>;
            retro-tap;
        };
    };

    combos {
        compatible = "zmk,combos";

        mo3 {
            bindings = <&mo 3>;
            key-positions = <41 42>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <16 17>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <29 30>;
        };

        combo_del {
            bindings = <&kp DELETE>;
            key-positions = <3 4>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <15 17>;
        };

        backtick {
            bindings = <&kp GRAVE>;
            key-positions = <28 29>;
        };

        toggle_gaming {
            bindings = <&tog 4>;
            key-positions = <14 15 16 17>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp ESCAPE  &kp Q  &kp W   &kp E      &kp R  &kp T           &trans  &kp Y       &kp U         &kp I         &kp O       &kp P          &kp BACKSPACE
&kp TAB     &kp A  &kp S   &kp D      &kp F  &kp G           &trans  &kp H       &kp J         &kp K         &kp L       &kp SEMICOLON  &mt LEFT_ALT SQT
&kp LSHFT   &kp Z  &kp X   &kp C      &kp V  &kp B           &trans  &kp N       &kp M         &kp COMMA     &kp PERIOD  &kp SLASH      &kp RSHIFT
                   &trans  &kp LCTRL  &mo 1  &kp LEFT_GUI    &trans  &kp RETURN  &tlt 2 SPACE  &kp LEFT_ALT
                                                             &trans
            >;
        };

        NavAndFunction {
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &none     &trans  &kp C_VOLUME_UP    &kp HOME  &kp PAGE_UP    &kp INSERT  &kp PRINTSCREEN  &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &none     &trans  &kp LEFT           &kp DOWN  &kp UP         &kp RIGHT   &trans           &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &none     &trans  &kp C_VOLUME_DOWN  &kp END   &kp PAGE_DOWN  &kp DELETE  &trans           &trans
                &trans   &trans   &trans   &trans    &trans  &trans             &trans    &trans
                                                     &trans
            >;
        };

        NumAndSymbols {
            bindings = <
&kp TILDE  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH        &kp DOLLAR    &kp LEFT_BRACE          &trans  &kp RIGHT_BRACE        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp BACKSLASH  &trans
&trans     &kp PERCENT      &kp CARET    &kp AMPERSAND   &kp ASTERISK  &kp LEFT_BRACKET        &trans  &kp RIGHT_BRACKET      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PIPE       &trans
&trans     &kp PLUS         &kp EQUAL    &kp UNDERSCORE  &kp MINUS     &kp LEFT_PARENTHESIS    &trans  &kp RIGHT_PARENTHESIS  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_0   &trans
                            &trans       &trans          &trans        &trans                  &trans  &trans                 &trans        &trans
                                                                                               &trans
            >;
        };

        DeviceCtrl {
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &rgb_ug RGB_TOG  &trans  &trans  &trans  &trans  &ext_power EP_TOG
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans          &trans  &trans           &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans          &trans  &trans           &trans  &trans  &trans  &trans  &trans
                              &trans        &trans        &trans        &trans          &trans  &trans           &trans  &trans
                                                                                        &trans
            >;
        };

        Gaming {
            bindings = <
&kp ESCAPE  &kp Q  &kp W   &kp E      &kp R      &kp T           &trans  &kp Y       &kp U         &kp I         &kp O       &kp P          &kp BACKSPACE
&kp TAB     &kp A  &kp S   &kp D      &kp F      &kp G           &trans  &kp H       &kp J         &kp K         &kp L       &kp SEMICOLON  &mt LEFT_ALT SQT
&kp LSHFT   &kp Z  &kp X   &kp C      &kp V      &kp B           &trans  &kp N       &kp M         &kp COMMA     &kp PERIOD  &kp SLASH      &kp RSHIFT
                   &trans  &kp LCTRL  &kp SPACE  &kp LEFT_GUI    &trans  &kp RETURN  &tlt 2 SPACE  &kp LEFT_ALT
                                                                 &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
